{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "new-posi-staging",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-30",
  "workers_dev": true,
  "routes": [],
  "preview_urls": false,
  "observability": { "enabled": false },
  "assets": { "directory": "./.preview-public", "binding": "ASSETS", "run_worker_first": true },
  "vars": {
    "POSI_ENABLED": "false",
    "POSI_AI_ENABLED": "false",
    "POSI_ALLOWED_ORIGINS": "http://127.0.0.1:8788,http://localhost:8788,http://127.0.0.1:8789,http://localhost:8789,http://127.0.0.1:8790,http://localhost:8790,https://new-posi-staging.yudhi7208.workers.dev",
    "POSI_AI_MODEL": "@cf/meta/llama-3.1-8b-instruct",
    "POSI_AI_MAX_TOKENS": "96"
  },
  "ratelimits": [
    { "name": "POSI_RATE_LIMITER", "namespace_id": "2026110301", "simple": { "limit": 20, "period": 60 } },
    { "name": "POSI_AI_RATE_LIMITER", "namespace_id": "2026110302", "simple": { "limit": 10, "period": 60 } }
  ]
}
