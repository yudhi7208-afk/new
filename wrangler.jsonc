{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "new",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-30",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "CUSTOMER_DB",
      "database_name": "new-posloker-customers",
      "database_id": "1cae88ec-6851-4468-9a01-a547f5352bca",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "CUSTOMER_FILES",
      "bucket_name": "new-posloker-customer-files"
    }
  ]
}
